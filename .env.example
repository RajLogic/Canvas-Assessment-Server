# Canvas Assessment Server - Environment Variables

# Canvas API Configuration
API_KEY=your_actual_canvas_api_token_here
# Alternative names also supported:
# CANVAS_API_TOKEN=your_actual_canvas_api_token_here
# CANVAS_TOKEN=your_actual_canvas_api_token_here
# CANVAS_ACCESS_TOKEN=your_actual_canvas_api_token_here
CANVAS_BASE_URL=https://rmit.instructure.com/api/v1/

# Next.js Environment
NODE_ENV=development
PORT=3000

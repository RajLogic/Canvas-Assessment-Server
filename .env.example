# ─── Database (Neon Serverless Postgres) ─────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ─── Encryption ───────────────────────────────────────────────────────────────
# Used to AES-256-GCM encrypt Canvas API tokens, timetable links, and Canvas
# base URLs before storing in the database.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 16 characters. Keep this secret — rotate it to invalidate
# all stored credentials (users will need to re-enter their tokens).
ENCRYPTION_KEY=replace_with_a_random_64_char_hex_string

# ─── Canvas (server-wide fallback) ───────────────────────────────────────────
# Used when a logged-in user has not set their own Canvas token in Settings.
# Per-user tokens (set in the dashboard) always take priority over this.
API_KEY=your_actual_canvas_api_token_here
CANVAS_BASE_URL=https://rmit.instructure.com/api/v1/

# ─── Timetable (server-wide fallback) ────────────────────────────────────────
# Per-user timetable links (set in Settings) take priority over this.
TIMETABLE_LINK=https://your-timetable-provider.com/calendar.ics

# ─── Next.js ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
